# ─── PingCode OAuth app (ALL REQUIRED — no defaults) ─────────────
# This server uses the Authorization Code grant. Each end user does a
# one-time consent in their browser; the server issues them a stable
# MCP_TOKEN to put in their MCP client config. Admin never hands out
# tokens manually.
# Create an OAuth app in YOUR PingCode admin console and paste its values:
PINGCODE_CLIENT_ID=
PINGCODE_CLIENT_SECRET=

# REST API root of YOUR PingCode instance (the /open prefix is typical)
PINGCODE_REST_ROOT=https://pingcode.example.com/open

# Authorize page lives at <root>/oauth2/authorize (no /open prefix)
PINGCODE_AUTH_ROOT=https://pingcode.example.com

# Optional OAuth scope to request on authorize (shown on the consent page as
# 请求权限). Leave empty to request no explicit scope.
PINGCODE_SCOPE=

# ─── Token store encryption (REQUIRED) ───────────────────────────
# 32-byte key encrypting the per-user PingCode access/refresh tokens at rest
# (AES-256-GCM, SQLite store at TOKEN_STORE_PATH). Hex (64 chars) or base64.
# Generate once and NEVER rotate casually — a different key cannot read the
# existing store:
#   openssl rand -hex 32
TOKEN_STORE_KEY=

# ─── This server ─────────────────────────────────────────────────
# Public URL where this server is reachable from a user's browser.
# Used to build the OAuth redirect URI and the `claude mcp add` command
# shown on the callback page. MUST match the redirect URI registered in
# your PingCode OAuth app (<PUBLIC_BASE_URL>/oauth/callback).
# May include a path when the app is reverse-proxied under a prefix,
# e.g. https://host.example.com/sidecars/pingcode
PUBLIC_BASE_URL=https://mcp.example.com

# Path prefix for in-page links when a reverse proxy mounts the app under a
# prefix and strips it. Usually left unset: it is derived from
# PUBLIC_BASE_URL's path automatically. Set explicitly only to override.
#PUBLIC_BASE_PATH=/sidecars/pingcode

# Where the encrypted per-user token DB lives inside the container.
# (docker-compose bind-mounts ./data to /data on the host.) A legacy
# `/data/users.json` value is also accepted: the store maps it to a sibling
# users.db and imports+deletes the JSON on first boot.
TOKEN_STORE_PATH=/data/users.db

# Host port the container is published on.
HOST_PORT=8090

# Who can reach the published host port:
#   0.0.0.0   — public interface (server deploy straight to a port;
#               remember to open the firewall for HOST_PORT to match)
#   127.0.0.1 — localhost only (local dev behind ngrok / a reverse proxy)
BIND_ADDR=127.0.0.1

# ─── ngrok (LOCAL TESTING ONLY — leave blank on the server) ──────
# Only needed when running `docker compose --profile local up`. Get a free
# static domain at https://dashboard.ngrok.com → Domains → Create Domain,
# then set PUBLIC_BASE_URL=https://<NGROK_DOMAIN> above.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
