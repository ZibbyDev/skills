# figma-mcp — configuration. THERE ARE NO SECRETS HERE, by design.
#
# This service holds no Figma identity: each caller's own Personal Access Token
# rides in the MCP request header (X-Figma-Token) and is forwarded to Figma for
# that one request. Nothing is persisted, so there is no key to configure and
# nothing to rotate.
#
# Running as a Zibby sidecar? You set NONE of this. The control-plane derives
# PUBLIC_BASE_URL / PUBLIC_BASE_PATH from the box's advertised origin and the
# sidecar's resolved public mount, so the install command this server prints is
# always the URL the browser actually came in on. This file is for a bare
# `docker run` / local development.

# Public URL this server is reachable at, used to build the install command
# shown on the onboarding page. Local dev default: http://localhost:31091
PUBLIC_BASE_URL=http://localhost:31091

# Host port to publish the container on (the app always listens on 8090 inside).
HOST_PORT=31091

# Who can reach the published host port:
#   127.0.0.1 — localhost only (local dev / behind a reverse proxy)
#   0.0.0.0   — the public interface (open the firewall to match)
BIND_ADDR=127.0.0.1

# The name the onboarding page's install command registers the server under in
# the USER'S editor config. Cosmetic; per-person names matter only where people
# share one home directory.
MCP_NAME=figma

# ─── Advanced (rarely change) ────────────────────────────────────
# Figma-for-Government uses api.figma-gov.com.
# FIGMA_API_ROOT=https://api.figma.com
